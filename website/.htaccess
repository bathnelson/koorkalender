Options -Indexes
DirectoryIndex index.php

# Instellingen, code en de opslag van de pagina's zijn niet los op te vragen
<FilesMatch "^(config|lib|leden|beheer)\.php$|^\.user\.ini$|\.(json|lock|md)$">
    Require all denied
</FilesMatch>

RewriteEngine On
# Bestaande bestanden en mappen (opmaak, foto's, de kalender in kalender/) gewoon tonen, al het andere naar index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
